# Study Hub runs fully locally (browser IndexedDB) when these are empty.
#
# To enable sign-in and cross-device sync with Supabase:
#   1. Create a project at https://supabase.com and apply the SQL in supabase/migrations
#      (see docs/SUPABASE.md).
#   2. Copy this file to `.env.local` and fill in the two values below from
#      Project Settings -> API. The anon key is safe in the browser: Row Level Security
#      restricts every table to the signed-in user.
#
# Never put the service_role key in any VITE_* variable: those are bundled into the app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
